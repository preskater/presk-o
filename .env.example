# Fictitious values only. Copy to .env and replace every secret locally.
# Never commit a real .env: only this file is versioned.

# --- Public configuration (safe for the browser) -----------------------------
# Only NEXT_PUBLIC_* variables are exposed to the client bundle.
NEXT_PUBLIC_DEFAULT_CURRENCY=EUR
NEXT_PUBLIC_DEFAULT_TIME_ZONE=Europe/Paris

# --- Server-only configuration ----------------------------------------------
# PostgreSQL connection string. Never exposed to the browser.
DATABASE_URL=postgresql://dashboard:dashboard@localhost:5432/dashboard?schema=public

# Auth.js session secret: 32 bytes minimum.
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-fictitious-random-secret-at-least-32-bytes

# Set to false when the app is served behind a trusted proxy that sets the host.
AUTH_TRUST_HOST=true

# AES-256-GCM key protecting provider tokens at rest: 32 bytes, base64 encoded.
# Generate with: openssl rand -base64 32
INTEGRATION_ENCRYPTION_KEY=replace-with-a-fictitious-32-byte-base64-key

# --- Owner bootstrap (no public sign-up) -------------------------------------
# Used by `npm run db:seed` and by the `seed` service of docker compose to create
# or update the single owner account. The seed runs on every `up`, so these
# values are the source of truth for the password.
# Always fictitious in this file; the real values live in the local .env only.
SEED_OWNER_EMAIL=owner@example.test
SEED_OWNER_PASSWORD=ChangeMe-Locally-2026
SEED_OWNER_NAME=Proprietaire

# Set to true to put SEED_OWNER_PASSWORD back in force on the next `up` or `db:seed`,
# which is how a forgotten password is replaced. Left unset, the seed writes the
# password only when it creates the account, so a password changed from the Compte
# page is not silently reverted on the next restart.
SEED_OWNER_FORCE_PASSWORD=false

# --- The origin you browse (application and authentication must agree) ----------
# The `proxy` service, part of the `full` profile (see README), can be the front door:
# it listens on PROXY_PORT and forwards to the application. Two variables describe that
# single origin, in two roles, and both must equal the URL you actually type: the
# session cookie belongs to one host, so a mismatch either shows an empty page (wrong
# APP_HOST) or signs you in on another origin (wrong AUTH_URL).
#
# AUTH_URL is what the application is told, because it cannot infer it: the standalone
# server would otherwise answer with its own container name and internal port
# (http://<container-id>:3000), which no browser can reach.
#
# The default below is direct local access: `npm run dev`, or Compose without the local
# override, reached on this machine. It must be a valid absolute URL: a placeholder such
# as http://<your-ip>:3000 makes every page fail with ERR_INVALID_URL.
AUTH_URL=http://localhost:3000

# With compose.override.yaml (the Caddy proxy) present, the front door is the proxy and
# these three variables describe its origin instead. Local example:
#   AUTH_URL=http://dashboard.localhost:8888
#   APP_HOST=http://dashboard.localhost:8888
#   PROXY_PORT=8888
# On a server, replace the name with the public hostname (no scheme in APP_HOST to get
# HTTPS) and set PROXY_PORT to 80 or 443. To reach the stack from another machine, use
# that machine's address in AUTH_URL and APP_HOST as well, firewall permitting.

# Direct Compose access. Keep APP_BIND_HOST=127.0.0.1 for local-only access; use the
# public hostname/port supplied by your hosting platform in AUTH_URL. The Docker
# container name is not browser-reachable.
APP_BIND_HOST=0.0.0.0
APP_PORT=3000

# APP_HOST is the site address the proxy answers for. It carries the port on purpose:
# Caddy listens on the port of its site address, so that port must be the one PROXY_PORT
# publishes below. The scheme decides what is served: `http://` serves plain HTTP (what
# you want locally, there is no certificate to trust), a bare hostname
# (dashboard.example.com) serves HTTPS with an automatically obtained certificate, which
# is what a server needs — and then PROXY_PORT must be 80/443 to keep the URL port-free.
#
# `localhost` and `dashboard.localhost` need no hosts entry: `.localhost` and its
# subdomains are reserved for loopback (RFC 6761), so browsers and curl resolve them to
# this machine. Any other name does:
#   echo "127.0.0.1 dashboard.test" | sudo tee -a /etc/hosts
# and that same name must then be used in AUTH_URL too, with the same port. Keep
# APP_HOST equal to AUTH_URL whenever the proxy is in use.
APP_HOST=http://localhost:3000
# Port the proxy publishes; the same number must appear in APP_HOST above.
PROXY_PORT=3000

# --- Local PostgreSQL container (docker compose) -----------------------------
POSTGRES_USER=dashboard
POSTGRES_PASSWORD=dashboard
POSTGRES_DB=dashboard
# Host port published by the container. Change it if 5432 is already taken, and
# keep DATABASE_URL consistent (see above).
POSTGRES_PORT=5432

# --- Diagnostics (SO-03) ------------------------------------------------------
# Folder holding the backup.sh dumps, read by the diagnostics page for the age of
# the latest backup (names only, never the content). Optional: defaults to
# infra/backups; compose sets it to the read-only mount of that folder.
# BACKUP_DIR=infra/backups
# Optional build identifier shown on the diagnostics page, for example a commit hash.
# APP_VERSION=
